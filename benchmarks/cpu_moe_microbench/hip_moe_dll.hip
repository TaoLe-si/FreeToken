#include <hip/hip_runtime.h>
#include <cstdio>
#include <cstdarg>
#include <cstdlib>
#include <cstring>

#define CHK(x) do { hipError_t e_=(x); if(e_!=hipSuccess){fprintf(stderr,"HIP ERR %s @%d: %s\n",#x,__LINE__,hipGetErrorString(e_)); return -1;} } while(0)
#define DLLEXPORT extern "C" __attribute__((dllexport))

static void diag(const char* fmt, ...) {
    FILE* f = fopen("E:/FreeToken/igpu_dll_diag.log", "a");
    if (!f) return;
    va_list ap; va_start(ap, fmt);
    vfprintf(f, fmt, ap);
    va_end(ap);
    fclose(f);
}

static const int E       = 8;
static const int GU_ROWS = 1024;   // gate 512 + up 512
static const int GU_K    = 2048;
static const int GU_KB   = GU_K / 2;     // 1024 bytes/row
static const int GU_SC   = GU_K / 16;    // 128 scales/row
static const int INTER   = 512;
static const int DN_ROWS = 2048;
static const int DN_K    = 512;
static const int DN_KB   = DN_K / 2;     // 256 bytes/row
static const int DN_SC   = DN_K / 16;    // 32 scales/row

__host__ __device__ static inline float e4m3_decode(unsigned char b) {
  unsigned sign = b >> 7;
  unsigned exp  = (b >> 3) & 0xF;
  unsigned man  = b & 0x7;
  float v;
  if (exp == 0) v = ldexpf((float)man * (1.0f / 8.0f), -6);      // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 8.0f), (int)exp - 7);
  return sign ? -v : v;
}

__host__ __device__ static inline float f16_decode(unsigned short h) {
  unsigned sign = h >> 15;
  unsigned exp  = (h >> 10) & 0x1F;
  unsigned man  = h & 0x3FF;
  float v;
  if (exp == 0) v = ldexpf((float)man, -24);                   // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 1024.0f), (int)exp - 15);
  return sign ? -v : v;   // exp==31 never generated by f16_encode here (clamped to 0x7BFF)
}

// host-only fp16 encode (round-to-nearest-even); data range keeps it simple
static unsigned short f16_encode(float f) {
  unsigned bits; std::memcpy(&bits, &f, 4);
  unsigned sign = (bits >> 16) & 0x8000u;
  int exp = (int)((bits >> 23) & 0xFF) - 127;
  unsigned man = bits & 0x7FFFFFu;
  if ((bits & 0x7FFFFFFFu) == 0) return (unsigned short)sign;
  if (exp > 15)  return (unsigned short)(sign | 0x7BFFu);        // clamp
  if (exp < -14) {                                               // subnormal
    int m = (int)ldexpf(f, 24);
    if (m < 0) m = -m;
    return (unsigned short)(sign | (unsigned)(m & 0x3FF));
  }
  unsigned h = ((unsigned)(exp + 15) << 10) | (man >> 13);
  unsigned rem = man & 0x1FFF;
  if (rem > 0x1000 || (rem == 0x1000 && (h & 1))) h++;
  return (unsigned short)(sign | h);
}

static const float H_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                 -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};
__device__ const float D_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                     -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};

// ---------------- kernels ----------------
// Shared dequant helper: dot one float4 chunk (16B = 4 words = 32 codes,
// k0 = chunk*32) against x[k0..k0+31]. Word wq covers codes 8*wq..8*wq+7;
// since k0 is 32-aligned, words 0-1 use scale (k0>>4) and words 2-3 use
// scale ((k0+16)>>4). Returns the scale-weighted partial dot.
__device__ static inline float dot_chunk_f4(const float4 chunk,
                                            const float* __restrict__ ax,
                                            float sc0, float sc1) {
  const unsigned* w4 = reinterpret_cast<const unsigned*>(&chunk);
  float acc = 0.f;
  #pragma unroll
  for (int wq = 0; wq < 4; wq++) {              // 4 words x 8 codes
    unsigned w = w4[wq];
    float part = 0.f;
    const float* aw = ax + wq * 8;
    #pragma unroll
    for (int q = 0; q < 4; q++) {               // 4 bytes/word, lo nibble = even k
      int lo = (int)(w & 0xF); w >>= 4;
      int hi = (int)(w & 0xF); w >>= 4;
      part += aw[2 * q] * D_E2M1[lo] + aw[2 * q + 1] * D_E2M1[hi];
    }
    acc += part * (wq < 2 ? sc0 : sc1);
  }
  return acc;
}

// gate_up GEMV (tuned): block = 8 rows x 32 lanes; each lane reads TWO float4
// chunks (32B in flight, codes k = 32*lane .. 32*lane+31 and +512 bytes later),
// widening per-thread memory-level parallelism for the zero-copy PCIe read.

// ---- k_gate_up: with topk_ids routing ----
static const int GU_RPB = 8, GU_TPR = 16, GU_CPL = 4, GU_BLOCK = GU_RPB * GU_TPR;

__global__ void k_probe_bank(const unsigned char* __restrict__ bank, const unsigned short* __restrict__ glob, float* __restrict__ dst) {
    if (threadIdx.x == 0) {
        dst[0] = (float)bank[0]; dst[1] = (float)bank[1];
        dst[2] = (float)bank[2]; dst[3] = (float)bank[3];
        dst[4] = (float)glob[0];
    }
}

__global__ void k_probe(const float* __restrict__ src, float* __restrict__ dst) {
    if (threadIdx.x == 0) { dst[0] = src[0]; dst[1] = src[1]; dst[2] = src[2]; dst[3] = src[3]; }
}

__global__ void k_gate_up(const unsigned char* __restrict__ wpacked,
                          const unsigned char* __restrict__ wscale,
                          const unsigned short* __restrict__ wglobal,
                          const float* __restrict__ x,
                          const int* __restrict__ topk_ids,
                          float* __restrict__ gu) {
  int e_l  = blockIdx.x / (GU_ROWS / GU_RPB);
  int e    = topk_ids[e_l];
  int rb   = blockIdx.x % (GU_ROWS / GU_RPB);
  int t    = threadIdx.x;
  int r    = t / GU_TPR;
  int lane = t % GU_TPR;
  int n    = rb * GU_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * GU_ROWS + n) * GU_KB;

  float4 ch[GU_CPL];
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * GU_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++) {
    int k0 = (lane + c * GU_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + (k0 >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], x + k0, sc0, sc1);
  }

  __shared__ float sh[GU_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < GU_TPR; i++) s += sh[r * GU_TPR + i];
    gu[e_l * GU_ROWS + n] = s * f16_decode(wglobal[e * GU_ROWS + n]);
  }
}

__global__ void k_act(const float* __restrict__ gu, float* __restrict__ act) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i >= E * INTER) return;
  int e = i / INTER, j = i % INTER;
  float gate = gu[e * GU_ROWS + j];
  float up   = gu[e * GU_ROWS + INTER + j];
  act[i] = (gate / (1.f + expf(-gate))) * up;
}

static const int DN_RPB = 4, DN_TPR = 8, DN_CPL = 2, DN_BLOCK = DN_RPB * DN_TPR;

// ---- k_down: with topk_ids routing ----
__global__ void k_down(const unsigned char* __restrict__ wpacked,
                       const unsigned char* __restrict__ wscale,
                       const unsigned short* __restrict__ wglobal,
                       const float* __restrict__ act,
                       const float* __restrict__ topkw,
                       const int* __restrict__ topk_ids,
                       float* __restrict__ out) {
  int e_l  = blockIdx.x / (DN_ROWS / DN_RPB);
  int e    = topk_ids[e_l];
  int rb   = blockIdx.x % (DN_ROWS / DN_RPB);
  int t    = threadIdx.x;
  int r    = t / DN_TPR;
  int lane = t % DN_TPR;
  int n    = rb * DN_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * DN_ROWS + n) * DN_KB;

  float4 ch[DN_CPL];
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * DN_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++) {
    int k0 = (lane + c * DN_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + (k0 >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], act + e_l * INTER + k0, sc0, sc1);
  }

  __shared__ float sh[DN_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < DN_TPR; i++) s += sh[r * DN_TPR + i];
    s *= f16_decode(wglobal[e * DN_ROWS + n]);
    s *= topkw[e_l];
    atomicAdd(&out[n], s);
  }
}

// ---- bank registry + device buffers ----
#define MAX_LAYERS 64
static struct {
    const unsigned char* gu_pack;
    const unsigned char* gu_scale;
    const unsigned short* gu_global;
    const unsigned char* dn_pack;
    const unsigned char* dn_scale;
    const unsigned short* dn_global;
} g_banks[MAX_LAYERS];
static float* d_gu = nullptr;
static float* d_act = nullptr;
static float* d_out = nullptr;
static float* g_h_out = nullptr;
static hipStream_t g_stream = nullptr;

// Phase 1: 暴露 stream 句柄给 Python, 调用方自己 sync
DLLEXPORT hipStream_t igpu_get_stream(void) {
    return g_stream;
}
static int g_init = 0;

DLLEXPORT int igpu_meminfo(size_t* free_b, size_t* total_b) {
    return hipMemGetInfo(free_b, total_b) == hipSuccess ? 0 : -1;
}

DLLEXPORT void* igpu_devmalloc(size_t nbytes) {
    void* p = nullptr;
    hipError_t rc = hipMalloc(&p, nbytes);
    if (rc != hipSuccess) {
        diag("devmalloc %zu failed: %d\n", nbytes, (int)rc);
        return nullptr;
    }
    return p;
}

DLLEXPORT int igpu_devfree(void* p) {
    return hipFree(p) == hipSuccess ? 0 : -1;
}

DLLEXPORT void* igpu_hostmalloc(size_t nbytes) {
    void* h = nullptr;
    hipError_t rc = hipHostMalloc(&h, nbytes, hipHostMallocMapped);
    if (rc != hipSuccess) {
        diag("hostmalloc %zu failed: %d\n", nbytes, (int)rc);
        return nullptr;
    }
    return h;
}

DLLEXPORT int igpu_hostfree(void* h) {
    return hipHostFree(h) == hipSuccess ? 0 : -1;
}

DLLEXPORT int igpu_init(void) {
    if (g_init) return 0;
    CHK(hipInit(0));
    CHK(hipSetDevice(0));
    CHK(hipStreamCreate(&g_stream));
    CHK(hipMalloc(&d_gu, E * GU_ROWS * sizeof(float)));
    CHK(hipMalloc(&d_act, E * INTER * sizeof(float)));
    {   // APU: 输出走 host-mapped 内存，kernel 直接写、宿主直接读，无需 hipMemcpy
        void* h_out = nullptr;
        CHK(hipHostMalloc(&h_out, DN_ROWS * sizeof(float), hipHostMallocMapped));
        { void* dp = nullptr; CHK(hipHostGetDevicePointer(&dp, h_out, 0)); d_out = (float*)dp; }
        g_h_out = (float*)h_out;
    }
    memset(g_banks, 0, sizeof(g_banks));
    g_init = 1;
    return 0;
}

DLLEXPORT int igpu_register_layer_dev(int layer,
    void* gu_pack, void* gu_scale, void* gu_global,
    void* dn_pack, void* dn_scale, void* dn_global) {
    // 形态二: 指针已是 hipMalloc 设备内存, 直接登记
    if (layer < 0 || layer >= MAX_LAYERS) return -1;
    g_banks[layer].gu_pack   = (const unsigned char*)gu_pack;
    g_banks[layer].gu_scale  = (const unsigned char*)gu_scale;
    g_banks[layer].gu_global = (const unsigned short*)gu_global;
    g_banks[layer].dn_pack   = (const unsigned char*)dn_pack;
    g_banks[layer].dn_scale  = (const unsigned char*)dn_scale;
    g_banks[layer].dn_global = (const unsigned short*)dn_global;
    return 0;
}

DLLEXPORT int igpu_register_layer(int layer,
    void* gu_pack, void* gu_scale, void* gu_global,
    void* dn_pack, void* dn_scale, void* dn_global) {
    if (layer < 0 || layer >= MAX_LAYERS) return -1;
    void *d = nullptr;
    const void* ptrs[6] = {gu_pack, gu_scale, gu_global, dn_pack, dn_scale, dn_global};
    for (int i = 0; i < 6; i++) {
        hipError_t rr = hipHostGetDevicePointer(&d, (void*)ptrs[i], 0);
        if (rr != hipSuccess || !d) {
            diag("[igpu-dll] register layer %d bank %d: rc=%d dev=%p host=%p\n",
                    layer, i, (int)rr, d, ptrs[i]);
            return -8;
        }
        switch (i) {
            case 0: g_banks[layer].gu_pack   = (const unsigned char*)d; break;
            case 1: g_banks[layer].gu_scale  = (const unsigned char*)d; break;
            case 2: g_banks[layer].gu_global = (const unsigned short*)d; break;
            case 3: g_banks[layer].dn_pack   = (const unsigned char*)d; break;
            case 4: g_banks[layer].dn_scale  = (const unsigned char*)d; break;
            case 5: g_banks[layer].dn_global = (const unsigned short*)d; break;
        }
    }
    return 0;
}

DLLEXPORT int igpu_moe_decode_dev(int layer,
    const float* hidden, const int* topk_ids, const float* topkw, float* out) {
    // 形态二: 全部为 780M 设备指针; bank 已登记, IO 也应在设备内存
    if (!g_init || layer < 0 || layer >= MAX_LAYERS) return -1;
    auto& b = g_banks[layer];
    if (!b.gu_pack) return -2;
    // Bounds check removed -- engine side validates ids before sending request
    // (see freetoken.igpu.client.IgpuClient.decode()). Per-layer hipMemcpy D2H
    // was forcing a stream sync every layer (40 syncs/request), eating
    // ~10 ms. If ids are out of range, kernel writes garbage to d_out but
    // does not segfault (offset arithmetic only, no heap alloc).
    CHK(hipMemsetAsync(d_out, 0, DN_ROWS * sizeof(float), g_stream));
    hipLaunchKernelGGL(k_gate_up, dim3(E * (GU_ROWS / GU_RPB)), dim3(GU_BLOCK), 0, g_stream,
                       b.gu_pack, b.gu_scale, b.gu_global, hidden, topk_ids, d_gu);
    hipLaunchKernelGGL(k_act, dim3((E * INTER) / 256), dim3(256), 0, g_stream, d_gu, d_act);
    hipLaunchKernelGGL(k_down, dim3(E * (DN_ROWS / DN_RPB)), dim3(DN_BLOCK), 0, g_stream,
                       b.dn_pack, b.dn_scale, b.dn_global, d_act, topkw, topk_ids, out);
    hipError_t le = hipGetLastError();
    if (le != hipSuccess) { diag("launch err: %s\n", hipGetErrorString(le)); return -3; }
    // Phase 1: 移除 hipStreamSynchronize, 调用方控制 sync 时机 (允许 HIP stream queue)
    return 0;
}

DLLEXPORT int igpu_moe_decode(int layer,
    const float* hidden, const int* topk_ids, const float* topkw, float* out) {
    diag("decode: layer=%d g_init=%d hid=%p ids=%p tkw=%p out=%p\n", layer, g_init, (void*)hidden, (void*)topk_ids, (void*)topkw, (void*)out);
    if (!g_init || layer < 0 || layer >= MAX_LAYERS) return -1;
    auto& b = g_banks[layer];
    if (!b.gu_pack) return -2;
    void *d_hid = nullptr, *d_tkw = nullptr, *d_ids = nullptr;
    hipError_t r1 = hipHostGetDevicePointer(&d_hid, (void*)hidden, 0);
    hipError_t r2 = hipHostGetDevicePointer(&d_tkw, (void*)topkw, 0);
    hipError_t r3 = hipHostGetDevicePointer(&d_ids, (void*)topk_ids, 0);
    if (r1 != hipSuccess || r2 != hipSuccess || r3 != hipSuccess) {
        diag("[igpu-dll] getdevptr failed: hid=%d tkw=%d ids=%d (host=%p/%p/%p)\n",
                (int)r1, (int)r2, (int)r3, (void*)hidden, (void*)topkw, (void*)topk_ids);
        return -5;
    }
    if (!d_hid || !d_tkw || !d_ids) {
        diag("[igpu-dll] null device ptr: hid=%p tkw=%p ids=%p\n", d_hid, d_tkw, d_ids);
        return -6;
    }
    {   // 路由 id 越界防御：越界 id 会让 kernel 读到 bank 外的地址
        int ids_host[8];
        memcpy(ids_host, topk_ids, E * sizeof(int));
        for (int i = 0; i < E; i++) {
            if (ids_host[i] < 0 || ids_host[i] >= 256) {
                diag("[igpu-dll] bad topk_ids[%d]=%d\n", i, ids_host[i]);
                return -7;
            }
        }
    }
    diag("ids bounds ok\n");
    {
        const unsigned char* p0 = (const unsigned char*)b.gu_pack;
        diag("host view bank bytes = %d %d %d %d (dev alias %p)\n", (int)p0[0], (int)p0[1], (int)p0[2], (int)p0[3], (void*)b.gu_pack);
    }
    CHK(hipMemsetAsync(d_out, 0, DN_ROWS * sizeof(float), g_stream));
    diag("memset ok\n");
    diag("launch gu: pack=%p scale=%p glob=%p\n", (void*)b.gu_pack, (void*)b.gu_scale, (void*)b.gu_global);
    hipLaunchKernelGGL(k_gate_up, dim3(E * (GU_ROWS / GU_RPB)), dim3(GU_BLOCK), 0, g_stream,
                       b.gu_pack, b.gu_scale, b.gu_global, (const float*)d_hid, (const int*)d_ids, d_gu);
    diag("gu launched\n");
    hipLaunchKernelGGL(k_act, dim3((E * INTER) / 256), dim3(256), 0, g_stream, d_gu, d_act);
    diag("act launched\n");
    hipLaunchKernelGGL(k_down, dim3(E * (DN_ROWS / DN_RPB)), dim3(DN_BLOCK), 0, g_stream,
                       b.dn_pack, b.dn_scale, b.dn_global, d_act, (const float*)d_tkw, (const int*)d_ids, d_out);
    diag("down launched\n");
    hipError_t le = hipGetLastError();
    if (le != hipSuccess) { diag("launch err: %s\n", hipGetErrorString(le)); return -3; }
    {
        float saved[4];
        hipMemcpy(saved, d_out, 16, hipMemcpyDeviceToHost);
        hipLaunchKernelGGL(k_probe, dim3(1), dim3(1), 0, g_stream, (const float*)d_hid, d_out);
        hipStreamSynchronize(g_stream);
        float probe[4];
        hipMemcpy(probe, d_out, 16, hipMemcpyDeviceToHost);
        diag("kernel probe hidden[0..3] = %.6g %.6g %.6g %.6g\n", probe[0], probe[1], probe[2], probe[3]);
        hipMemcpy(d_out, saved, 16, hipMemcpyHostToDevice);
        {
            float pb[5];
            hipLaunchKernelGGL(k_probe_bank, dim3(1), dim3(1), 0, g_stream, b.gu_pack, b.gu_global, d_out);
            hipStreamSynchronize(g_stream);
            hipMemcpy(pb, d_out, 20, hipMemcpyDeviceToHost);
            diag("kernel probe bank bytes = %.0f %.0f %.0f %.0f glob=%.0f\n", pb[0], pb[1], pb[2], pb[3], pb[4]);
        }
    }
    CHK(hipStreamSynchronize(g_stream));
    diag("sync ok\n");
    memcpy(out, g_h_out, DN_ROWS * sizeof(float));
    diag("memcpy ok\n");
    return 0;
}

DLLEXPORT const char* igpu_version(void) {
    return "P1b hip_moe_dll v8.2-devbanks (gfx1103, NVFP4, E=8, topk_ids routing)";
}
