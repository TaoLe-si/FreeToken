#include <hip/hip_runtime.h>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#define CHK(x) do { hipError_t e_=(x); if(e_!=hipSuccess){fprintf(stderr,"HIP ERR %s @%d: %s\n",#x,__LINE__,hipGetErrorString(e_)); return -1;} } while(0)
#define DLLEXPORT extern "C" __attribute__((dllexport))

static const int E       = 8;
static const int GU_ROWS = 1024;   // gate 512 + up 512
static const int GU_K    = 2048;
static const int GU_KB   = GU_K / 2;     // 1024 bytes/row
static const int GU_SC   = GU_K / 16;    // 128 scales/row
static const int INTER   = 512;
static const int DN_ROWS = 2048;
static const int DN_K    = 512;
static const int DN_KB   = DN_K / 2;     // 256 bytes/row
static const int DN_SC   = DN_K / 16;    // 32 scales/row

__host__ __device__ static inline float e4m3_decode(unsigned char b) {
  unsigned sign = b >> 7;
  unsigned exp  = (b >> 3) & 0xF;
  unsigned man  = b & 0x7;
  float v;
  if (exp == 0) v = ldexpf((float)man * (1.0f / 8.0f), -6);      // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 8.0f), (int)exp - 7);
  return sign ? -v : v;
}

__host__ __device__ static inline float f16_decode(unsigned short h) {
  unsigned sign = h >> 15;
  unsigned exp  = (h >> 10) & 0x1F;
  unsigned man  = h & 0x3FF;
  float v;
  if (exp == 0) v = ldexpf((float)man, -24);                   // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 1024.0f), (int)exp - 15);
  return sign ? -v : v;   // exp==31 never generated by f16_encode here (clamped to 0x7BFF)
}

// host-only fp16 encode (round-to-nearest-even); data range keeps it simple
static unsigned short f16_encode(float f) {
  unsigned bits; std::memcpy(&bits, &f, 4);
  unsigned sign = (bits >> 16) & 0x8000u;
  int exp = (int)((bits >> 23) & 0xFF) - 127;
  unsigned man = bits & 0x7FFFFFu;
  if ((bits & 0x7FFFFFFFu) == 0) return (unsigned short)sign;
  if (exp > 15)  return (unsigned short)(sign | 0x7BFFu);        // clamp
  if (exp < -14) {                                               // subnormal
    int m = (int)ldexpf(f, 24);
    if (m < 0) m = -m;
    return (unsigned short)(sign | (unsigned)(m & 0x3FF));
  }
  unsigned h = ((unsigned)(exp + 15) << 10) | (man >> 13);
  unsigned rem = man & 0x1FFF;
  if (rem > 0x1000 || (rem == 0x1000 && (h & 1))) h++;
  return (unsigned short)(sign | h);
}

static const float H_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                 -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};
__device__ const float D_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                     -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};

// ---------------- kernels ----------------
// Shared dequant helper: dot one float4 chunk (16B = 4 words = 32 codes,
// k0 = chunk*32) against x[k0..k0+31]. Word wq covers codes 8*wq..8*wq+7;
// since k0 is 32-aligned, words 0-1 use scale (k0>>4) and words 2-3 use
// scale ((k0+16)>>4). Returns the scale-weighted partial dot.
__device__ static inline float dot_chunk_f4(const float4 chunk,
                                            const float* __restrict__ ax,
                                            float sc0, float sc1) {
  const unsigned* w4 = reinterpret_cast<const unsigned*>(&chunk);
  float acc = 0.f;
  #pragma unroll
  for (int wq = 0; wq < 4; wq++) {              // 4 words x 8 codes
    unsigned w = w4[wq];
    float part = 0.f;
    const float* aw = ax + wq * 8;
    #pragma unroll
    for (int q = 0; q < 4; q++) {               // 4 bytes/word, lo nibble = even k
      int lo = (int)(w & 0xF); w >>= 4;
      int hi = (int)(w & 0xF); w >>= 4;
      part += aw[2 * q] * D_E2M1[lo] + aw[2 * q + 1] * D_E2M1[hi];
    }
    acc += part * (wq < 2 ? sc0 : sc1);
  }
  return acc;
}

// gate_up GEMV (tuned): block = 8 rows x 32 lanes; each lane reads TWO float4
// chunks (32B in flight, codes k = 32*lane .. 32*lane+31 and +512 bytes later),
// widening per-thread memory-level parallelism for the zero-copy PCIe read.

// ---- k_gate_up: with topk_ids routing ----
static const int GU_RPB = 8, GU_TPR = 16, GU_CPL = 4, GU_BLOCK = GU_RPB * GU_TPR;

__global__ void k_gate_up(const unsigned char* __restrict__ wpacked,
                          const unsigned char* __restrict__ wscale,
                          const unsigned short* __restrict__ wglobal,
                          const float* __restrict__ x,
                          const int* __restrict__ topk_ids,
                          float* __restrict__ gu) {
  int e_l  = blockIdx.x / (GU_ROWS / GU_RPB);
  int e    = topk_ids[e_l];
  int rb   = blockIdx.x % (GU_ROWS / GU_RPB);
  int t    = threadIdx.x;
  int r    = t / GU_TPR;
  int lane = t % GU_TPR;
  int n    = rb * GU_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * GU_ROWS + n) * GU_KB;

  float4 ch[GU_CPL];
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * GU_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++) {
    int k0 = (lane + c * GU_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + (k0 >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], x + k0, sc0, sc1);
  }

  __shared__ float sh[GU_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < GU_TPR; i++) s += sh[r * GU_TPR + i];
    gu[e_l * GU_ROWS + n] = s * f16_decode(wglobal[e * GU_ROWS + n]);
  }
}

__global__ void k_act(const float* __restrict__ gu, float* __restrict__ act) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i >= E * INTER) return;
  int e = i / INTER, j = i % INTER;
  float gate = gu[e * GU_ROWS + j];
  float up   = gu[e * GU_ROWS + INTER + j];
  act[i] = (gate / (1.f + expf(-gate))) * up;
}

static const int DN_RPB = 4, DN_TPR = 8, DN_CPL = 2, DN_BLOCK = DN_RPB * DN_TPR;

// ---- k_down: with topk_ids routing ----
__global__ void k_down(const unsigned char* __restrict__ wpacked,
                       const unsigned char* __restrict__ wscale,
                       const unsigned short* __restrict__ wglobal,
                       const float* __restrict__ act,
                       const float* __restrict__ topkw,
                       const int* __restrict__ topk_ids,
                       float* __restrict__ out) {
  int e_l  = blockIdx.x / (DN_ROWS / DN_RPB);
  int e    = topk_ids[e_l];
  int rb   = blockIdx.x % (DN_ROWS / DN_RPB);
  int t    = threadIdx.x;
  int r    = t / DN_TPR;
  int lane = t % DN_TPR;
  int n    = rb * DN_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * DN_ROWS + n) * DN_KB;

  float4 ch[DN_CPL];
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * DN_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++) {
    int k0 = (lane + c * DN_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + (k0 >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], act + e_l * INTER + k0, sc0, sc1);
  }

  __shared__ float sh[DN_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < DN_TPR; i++) s += sh[r * DN_TPR + i];
    s *= f16_decode(wglobal[e * DN_ROWS + n]);
    s *= topkw[e_l];
    atomicAdd(&out[n], s);
  }
}

// ---- bank registry + device buffers ----
#define MAX_LAYERS 64
static struct {
    const unsigned char* gu_pack;
    const unsigned char* gu_scale;
    const unsigned short* gu_global;
    const unsigned char* dn_pack;
    const unsigned char* dn_scale;
    const unsigned short* dn_global;
} g_banks[MAX_LAYERS];
static float* d_gu = nullptr;
static float* d_act = nullptr;
static float* d_out = nullptr;
static hipStream_t g_stream = nullptr;
static int g_init = 0;

DLLEXPORT int igpu_init(void) {
    if (g_init) return 0;
    CHK(hipInit(0));
    CHK(hipSetDevice(0));
    CHK(hipStreamCreate(&g_stream));
    CHK(hipMalloc(&d_gu, E * GU_ROWS * sizeof(float)));
    CHK(hipMalloc(&d_act, E * INTER * sizeof(float)));
    CHK(hipMalloc(&d_out, DN_ROWS * sizeof(float)));
    memset(g_banks, 0, sizeof(g_banks));
    g_init = 1;
    return 0;
}

DLLEXPORT int igpu_register_layer(int layer,
    void* gu_pack, void* gu_scale, void* gu_global,
    void* dn_pack, void* dn_scale, void* dn_global) {
    if (layer < 0 || layer >= MAX_LAYERS) return -1;
    void *d;
    hipHostGetDevicePointer(&d, gu_pack, 0);    g_banks[layer].gu_pack  = (const unsigned char*)d;
    hipHostGetDevicePointer(&d, gu_scale, 0);   g_banks[layer].gu_scale = (const unsigned char*)d;
    hipHostGetDevicePointer(&d, gu_global, 0);  g_banks[layer].gu_global= (const unsigned short*)d;
    hipHostGetDevicePointer(&d, dn_pack, 0);    g_banks[layer].dn_pack  = (const unsigned char*)d;
    hipHostGetDevicePointer(&d, dn_scale, 0);   g_banks[layer].dn_scale = (const unsigned char*)d;
    hipHostGetDevicePointer(&d, dn_global, 0);  g_banks[layer].dn_global= (const unsigned short*)d;
    return 0;
}

DLLEXPORT int igpu_moe_decode(int layer,
    const float* hidden, const int* topk_ids, const float* topkw, float* out) {
    if (!g_init || layer < 0 || layer >= MAX_LAYERS) return -1;
    auto& b = g_banks[layer];
    if (!b.gu_pack) return -2;
    void *d_hid, *d_tkw, *d_ids;
    hipHostGetDevicePointer(&d_hid, (void*)hidden, 0);
    hipHostGetDevicePointer(&d_tkw, (void*)topkw, 0);
    hipHostGetDevicePointer(&d_ids, (void*)topk_ids, 0);
    CHK(hipMemsetAsync(d_out, 0, DN_ROWS * sizeof(float), g_stream));
    hipLaunchKernelGGL(k_gate_up, dim3(E * (GU_ROWS / GU_RPB)), dim3(GU_BLOCK), 0, g_stream,
                       b.gu_pack, b.gu_scale, b.gu_global, (const float*)d_hid, (const int*)d_ids, d_gu);
    hipLaunchKernelGGL(k_act, dim3((E * INTER) / 256), dim3(256), 0, g_stream, d_gu, d_act);
    hipLaunchKernelGGL(k_down, dim3(E * (DN_ROWS / DN_RPB)), dim3(DN_BLOCK), 0, g_stream,
                       b.dn_pack, b.dn_scale, b.dn_global, d_act, (const float*)d_tkw, (const int*)d_ids, d_out);
    hipError_t le = hipGetLastError();
    if (le != hipSuccess) { fprintf(stderr, "launch err: %s\n", hipGetErrorString(le)); return -3; }
    CHK(hipStreamSynchronize(g_stream));
    CHK(hipMemcpy(out, d_out, DN_ROWS * sizeof(float), hipMemcpyDeviceToHost));
    return 0;
}

DLLEXPORT const char* igpu_version(void) {
    return "P1b hip_moe_dll v2 (gfx1103, NVFP4, E=8, topk_ids routing)";
}
