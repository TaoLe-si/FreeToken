// hip_nvfp4_gemv.hip — P1a: fused per-layer MoE GEMV, NVFP4, gfx1103 (Radeon 780M)
// One token, E=8 experts, weights read straight from PINNED HOST memory (zero-copy,
// hipHostMalloc) exactly like hip_shared_bw.hip; activations in device memory.
//
// Layout (per expert), matches python/freetoken/kernel/triton/nvfp4_fused_moe.py:
//   gate_up: packed u8 [1024, 1024] (2x e2m1/byte, LOW nibble = even k, K=2048)
//            scale e4m3 [1024, 128] (per-16 block along K, index k>>4)
//            global fp16 [1024]
//   down:    packed u8 [2048, 256] (K=512), scale [2048, 32], global [2048]
//   W[n,k] = E2M1[code] * scale[n, k>>4] * global[n]
// NOTE on the split: gu has 1024 entries (gate_up is 1024 rows). Consistent with
// act[512] and down K=512 (and with the repo's UNINTERLEAVED gate-first halves,
// triton/activation.py: y = act(x[:d]) * x[d:]):
//   act[i] = silu(gu[i]) * gu[512+i],  i in [0,512)
// The task line "silu(gu[0:1024])*gu[1024:2048]" cannot hold (gu only has 1024
// entries); [0:512]/[512:1024] is the only self-consistent split.
//
// Flow per expert: gu[1024] -> act[512] -> down[2048] -> out += routed_w * down.

#include <hip/hip_runtime.h>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include <cmath>
#include <algorithm>

#define CHK(x) do { hipError_t e_=(x); if(e_!=hipSuccess){printf("HIP ERR %s @%d: %s\n",#x,__LINE__,hipGetErrorString(e_)); exit(1);} } while(0)

// ---------------- shapes ----------------
static const int E       = 8;
static const int GU_ROWS = 1024;   // gate 512 + up 512
static const int GU_K    = 2048;
static const int GU_KB   = GU_K / 2;     // 1024 bytes/row
static const int GU_SC   = GU_K / 16;    // 128 scales/row
static const int INTER   = 512;
static const int DN_ROWS = 2048;
static const int DN_K    = 512;
static const int DN_KB   = DN_K / 2;     // 256 bytes/row
static const int DN_SC   = DN_K / 16;    // 32 scales/row

__host__ __device__ static inline float e4m3_decode(unsigned char b) {
  unsigned sign = b >> 7;
  unsigned exp  = (b >> 3) & 0xF;
  unsigned man  = b & 0x7;
  float v;
  if (exp == 0) v = ldexpf((float)man * (1.0f / 8.0f), -6);      // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 8.0f), (int)exp - 7);
  return sign ? -v : v;
}

__host__ __device__ static inline float f16_decode(unsigned short h) {
  unsigned sign = h >> 15;
  unsigned exp  = (h >> 10) & 0x1F;
  unsigned man  = h & 0x3FF;
  float v;
  if (exp == 0) v = ldexpf((float)man, -24);                   // subnormal
  else          v = ldexpf(1.0f + (float)man * (1.0f / 1024.0f), (int)exp - 15);
  return sign ? -v : v;   // exp==31 never generated by f16_encode here (clamped to 0x7BFF)
}

// host-only fp16 encode (round-to-nearest-even); data range keeps it simple
static unsigned short f16_encode(float f) {
  unsigned bits; std::memcpy(&bits, &f, 4);
  unsigned sign = (bits >> 16) & 0x8000u;
  int exp = (int)((bits >> 23) & 0xFF) - 127;
  unsigned man = bits & 0x7FFFFFu;
  if ((bits & 0x7FFFFFFFu) == 0) return (unsigned short)sign;
  if (exp > 15)  return (unsigned short)(sign | 0x7BFFu);        // clamp
  if (exp < -14) {                                               // subnormal
    int m = (int)ldexpf(f, 24);
    if (m < 0) m = -m;
    return (unsigned short)(sign | (unsigned)(m & 0x3FF));
  }
  unsigned h = ((unsigned)(exp + 15) << 10) | (man >> 13);
  unsigned rem = man & 0x1FFF;
  if (rem > 0x1000 || (rem == 0x1000 && (h & 1))) h++;
  return (unsigned short)(sign | h);
}

static const float H_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                 -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};
__device__ const float D_E2M1[16] = {0.f,0.5f,1.f,1.5f,2.f,3.f,4.f,6.f,
                                     -0.f,-0.5f,-1.f,-1.5f,-2.f,-3.f,-4.f,-6.f};

// ---------------- kernels ----------------
// Shared dequant helper: dot one float4 chunk (16B = 4 words = 32 codes,
// k0 = chunk*32) against x[k0..k0+31]. Word wq covers codes 8*wq..8*wq+7;
// since k0 is 32-aligned, words 0-1 use scale (k0>>4) and words 2-3 use
// scale ((k0+16)>>4). Returns the scale-weighted partial dot.
__device__ static inline float dot_chunk_f4(const float4 chunk,
                                            const float* __restrict__ ax,
                                            float sc0, float sc1) {
  const unsigned* w4 = reinterpret_cast<const unsigned*>(&chunk);
  float acc = 0.f;
  #pragma unroll
  for (int wq = 0; wq < 4; wq++) {              // 4 words x 8 codes
    unsigned w = w4[wq];
    float part = 0.f;
    const float* aw = ax + wq * 8;
    #pragma unroll
    for (int q = 0; q < 4; q++) {               // 4 bytes/word, lo nibble = even k
      int lo = (int)(w & 0xF); w >>= 4;
      int hi = (int)(w & 0xF); w >>= 4;
      part += aw[2 * q] * D_E2M1[lo] + aw[2 * q + 1] * D_E2M1[hi];
    }
    acc += part * (wq < 2 ? sc0 : sc1);
  }
  return acc;
}

// gate_up GEMV (tuned): block = 8 rows x 32 lanes; each lane reads TWO float4
// chunks (32B in flight, codes k = 32*lane .. 32*lane+31 and +512 bytes later),
// widening per-thread memory-level parallelism for the zero-copy PCIe read.
static const int GU_RPB = 8, GU_TPR = 16, GU_CPL = 4, GU_BLOCK = GU_RPB * GU_TPR;

__global__ void k_gate_up(const unsigned char* __restrict__ wpacked,
                          const unsigned char* __restrict__ wscale,
                          const unsigned short* __restrict__ wglobal,
                          const float* __restrict__ x,
                          float* __restrict__ gu) {
  int e    = blockIdx.x / (GU_ROWS / GU_RPB);
  int rb   = blockIdx.x % (GU_ROWS / GU_RPB);
  int t    = threadIdx.x;
  int r    = t / GU_TPR;
  int lane = t % GU_TPR;
  int n    = rb * GU_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * GU_ROWS + n) * GU_KB;

  // issue all chunk loads first (independent) for MLP
  float4 ch[GU_CPL];
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * GU_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < GU_CPL; c++) {
    int k0 = (lane + c * GU_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + ((k0)      >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * GU_ROWS + n) * GU_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], x + k0, sc0, sc1);
  }

  __shared__ float sh[GU_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < GU_TPR; i++) s += sh[r * GU_TPR + i];
    gu[e * GU_ROWS + n] = s * f16_decode(wglobal[e * GU_ROWS + n]);
  }
}

// act: act[e*512+i] = silu(gu[e*1024+i]) * gu[e*1024+512+i]
__global__ void k_act(const float* __restrict__ gu, float* __restrict__ act) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i >= E * INTER) return;
  int e = i / INTER, j = i % INTER;
  float gate = gu[e * GU_ROWS + j];
  float up   = gu[e * GU_ROWS + INTER + j];
  act[i] = (gate / (1.f + expf(-gate))) * up;
}

// down GEMV + routed-weight accumulate (tuned): block = 8 rows x 8 lanes;
// each lane reads TWO float4 chunks (K=512 -> 256B = 16 chunks/row; lanes 0..7,
// chunks lane and lane+8). Small blocks -> many blocks -> deep queue.
static const int DN_RPB = 4, DN_TPR = 8, DN_CPL = 2, DN_BLOCK = DN_RPB * DN_TPR;

__global__ void k_down(const unsigned char* __restrict__ wpacked,
                       const unsigned char* __restrict__ wscale,
                       const unsigned short* __restrict__ wglobal,
                       const float* __restrict__ act,
                       const float* __restrict__ topkw,
                       float* __restrict__ out) {
  int e    = blockIdx.x / (DN_ROWS / DN_RPB);
  int rb   = blockIdx.x % (DN_ROWS / DN_RPB);
  int t    = threadIdx.x;
  int r    = t / DN_TPR;
  int lane = t % DN_TPR;
  int n    = rb * DN_RPB + r;
  const unsigned char* prow = wpacked + ((size_t)e * DN_ROWS + n) * DN_KB;

  float4 ch[DN_CPL];
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++)
    ch[c] = *reinterpret_cast<const float4*>(prow + (lane + c * DN_TPR) * 16);

  float acc = 0.f;
  #pragma unroll
  for (int c = 0; c < DN_CPL; c++) {
    int k0 = (lane + c * DN_TPR) * 32;
    float sc0 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + ((k0)      >> 4)]);
    float sc1 = e4m3_decode(wscale[((size_t)e * DN_ROWS + n) * DN_SC + ((k0 + 16) >> 4)]);
    acc += dot_chunk_f4(ch[c], act + e * INTER + k0, sc0, sc1);
  }

  __shared__ float sh[DN_BLOCK];
  sh[t] = acc;
  __syncthreads();
  if (lane == 0) {
    float s = 0.f;
    for (int i = 0; i < DN_TPR; i++) s += sh[r * DN_TPR + i];
    s *= f16_decode(wglobal[e * DN_ROWS + n]);
    s *= topkw[e];
    atomicAdd(&out[n], s);
  }
}

static float* d_x; static float* d_topkw; static float* d_gu; static float* d_act; static float* d_out;
static unsigned char *p_wgupack, *p_wgusc; static unsigned short* p_wguglob;
static unsigned char *p_dnpack, *p_dnsc;   static unsigned short* p_dnglob;

static inline void launch_layer() {
  hipLaunchKernelGGL(k_gate_up, dim3(E * (GU_ROWS / GU_RPB)), dim3(GU_BLOCK), 0, 0,
                     p_wgupack, p_wgusc, p_wguglob, d_x, d_gu);
  hipLaunchKernelGGL(k_act, dim3((E * INTER) / 256), dim3(256), 0, 0, d_gu, d_act);
  hipLaunchKernelGGL(k_down, dim3(E * (DN_ROWS / DN_RPB)), dim3(DN_BLOCK), 0, 0,
                     p_dnpack, p_dnsc, p_dnglob, d_act, d_topkw, d_out);
  // grid check: k_gate_up covers E * (GU_ROWS/GU_RPB) * GU_RPB = E*GU_ROWS rows
  // via lane*32-chunks; k_down covers E * (DN_ROWS/DN_RPB) * DN_RPB rows.
  static_assert(GU_TPR * GU_CPL * 32 == GU_K, "gate_up lane coverage");
  static_assert(DN_TPR * DN_CPL * 32 == DN_K, "down lane coverage");
  static_assert(GU_RPB * (GU_ROWS / GU_RPB) == GU_ROWS && DN_RPB * (DN_ROWS / DN_RPB) == DN_ROWS, "row coverage");
  hipError_t le = hipGetLastError();
  if (le != hipSuccess) { printf("launch err: %s\n", hipGetErrorString(le)); exit(1); }
}

int main() {
  CHK(hipInit(0));
  int ndev = 0; CHK(hipGetDeviceCount(&ndev));
  if (ndev <= 0) { printf("no HIP device\n"); return 1; }
  CHK(hipSetDevice(0));
  hipDeviceProp_t pr; CHK(hipGetDeviceProperties(&pr, 0));
  printf("dev: %s CU=%d gcn=%s warpSize=%d\n", pr.name, pr.multiProcessorCount, pr.gcnArchName, pr.warpSize);

  const size_t SZ_WGUPACK = (size_t)E * GU_ROWS * GU_KB;
  const size_t SZ_WGUSC   = (size_t)E * GU_ROWS * GU_SC;
  const size_t SZ_WGUGL   = (size_t)E * GU_ROWS;
  const size_t SZ_DNPACK  = (size_t)E * DN_ROWS * DN_KB;
  const size_t SZ_DNSC    = (size_t)E * DN_ROWS * DN_SC;
  const size_t SZ_DNGL    = (size_t)E * DN_ROWS;
  const size_t LAYER_BYTES = SZ_WGUPACK + SZ_WGUSC + SZ_WGUGL * 2 + SZ_DNPACK + SZ_DNSC + SZ_DNGL * 2;

  // ---- pinned host weights (zero-copy, the shared-pool path) ----
  CHK(hipHostMalloc((void**)&p_wgupack, SZ_WGUPACK, hipHostMallocDefault));
  CHK(hipHostMalloc((void**)&p_wgusc,   SZ_WGUSC,   hipHostMallocDefault));
  CHK(hipHostMalloc((void**)&p_wguglob, SZ_WGUGL * 2, hipHostMallocDefault));
  CHK(hipHostMalloc((void**)&p_dnpack,  SZ_DNPACK,  hipHostMallocDefault));
  CHK(hipHostMalloc((void**)&p_dnsc,    SZ_DNSC,    hipHostMallocDefault));
  CHK(hipHostMalloc((void**)&p_dnglob,  SZ_DNGL * 2, hipHostMallocDefault));

  // ---- deterministic data, srand(7) ----
  srand(7);
  std::vector<float> x_host(GU_K), tw_host(E);
  std::vector<float> gu_ref((size_t)E * GU_ROWS), act_ref((size_t)E * INTER), out_ref(DN_ROWS, 0.f);
  for (int i = 0; i < GU_K; i++)  x_host[i]  = (float)rand() / RAND_MAX * 2.f - 1.f;
  for (int e = 0; e < E; e++)     tw_host[e] = 0.1f + (float)rand() / RAND_MAX * 0.4f;
  for (size_t i = 0; i < SZ_WGUPACK; i++) p_wgupack[i] = (unsigned char)(rand() & 0xFF);
  for (size_t i = 0; i < SZ_DNPACK;  i++) p_dnpack[i]  = (unsigned char)(rand() & 0xFF);
  for (size_t i = 0; i < SZ_WGUSC; i++) {   // e4m3 bytes: exp 2..14, avoids NaN
    unsigned v = ((rand() & 1u) << 7) | ((unsigned)(2 + rand() % 13) << 3) | (rand() % 8);
    p_wgusc[i] = (unsigned char)v;
  }
  for (size_t i = 0; i < SZ_DNSC; i++) {
    unsigned v = ((rand() & 1u) << 7) | ((unsigned)(2 + rand() % 13) << 3) | (rand() % 8);
    p_dnsc[i] = (unsigned char)v;
  }
  for (size_t i = 0; i < SZ_WGUGL; i++) ((unsigned short*)p_wguglob)[i] = f16_encode(0.5f + (float)rand() / RAND_MAX * 1.5f);
  for (size_t i = 0; i < SZ_DNGL;  i++) ((unsigned short*)p_dnglob)[i]  = f16_encode(0.5f + (float)rand() / RAND_MAX * 1.5f);

  // ---- fp32 CPU reference (plain triple loops, same dequant math) ----
  // byte kb covers k = 2kb (LOW nibble) and 2kb+1 (HIGH nibble);
  // scale index (2kb)>>4 == kb>>3, exactly the kernel's "one scale per lane".
  for (int e = 0; e < E; e++)
    for (int n = 0; n < GU_ROWS; n++) {
      float s = 0.f;
      for (int kb = 0; kb < GU_KB; kb++) {
        unsigned char b = p_wgupack[((size_t)e * GU_ROWS + n) * GU_KB + kb];
        float sc = e4m3_decode(p_wgusc[((size_t)e * GU_ROWS + n) * GU_SC + (kb >> 3)]);
        int k = 2 * kb;
        s += (x_host[k] * H_E2M1[b & 0xF] + x_host[k + 1] * H_E2M1[b >> 4]) * sc;
      }
      gu_ref[(size_t)e * GU_ROWS + n] = s * f16_decode(((unsigned short*)p_wguglob)[e * GU_ROWS + n]);
    }
  for (int e = 0; e < E; e++)
    for (int i = 0; i < INTER; i++) {
      float g = gu_ref[(size_t)e * GU_ROWS + i], u = gu_ref[(size_t)e * GU_ROWS + INTER + i];
      act_ref[(size_t)e * INTER + i] = (g / (1.f + std::exp(-g))) * u;
    }
  for (int e = 0; e < E; e++)
    for (int n = 0; n < DN_ROWS; n++) {
      float s = 0.f;
      for (int kb = 0; kb < DN_KB; kb++) {
        unsigned char b = p_dnpack[((size_t)e * DN_ROWS + n) * DN_KB + kb];
        float sc = e4m3_decode(p_dnsc[((size_t)e * DN_ROWS + n) * DN_SC + (kb >> 3)]);
        int k = 2 * kb;
        s += (act_ref[(size_t)e * INTER + k] * H_E2M1[b & 0xF] +
              act_ref[(size_t)e * INTER + k + 1] * H_E2M1[b >> 4]) * sc;
      }
      out_ref[n] += tw_host[e] * s * f16_decode(((unsigned short*)p_dnglob)[e * DN_ROWS + n]);
    }

  // ---- device buffers (activations in device memory) ----
  CHK(hipMalloc((void**)&d_x, GU_K * 4));
  CHK(hipMalloc((void**)&d_topkw, E * 4));
  CHK(hipMalloc((void**)&d_gu, (size_t)E * GU_ROWS * 4));
  CHK(hipMalloc((void**)&d_act, (size_t)E * INTER * 4));
  CHK(hipMalloc((void**)&d_out, DN_ROWS * 4));
  CHK(hipMemcpy(d_x, x_host.data(), GU_K * 4, hipMemcpyHostToDevice));
  CHK(hipMemcpy(d_topkw, tw_host.data(), E * 4, hipMemcpyHostToDevice));

  // ---- correctness run ----
  CHK(hipMemset(d_out, 0, DN_ROWS * 4));
  launch_layer();
  CHK(hipDeviceSynchronize());
  std::vector<float> gu_got((size_t)E * GU_ROWS), act_got((size_t)E * INTER), out_got(DN_ROWS);
  CHK(hipMemcpy(gu_got.data(), d_gu, (size_t)E * GU_ROWS * 4, hipMemcpyDeviceToHost));
  CHK(hipMemcpy(act_got.data(), d_act, (size_t)E * INTER * 4, hipMemcpyDeviceToHost));
  CHK(hipMemcpy(out_got.data(), d_out, DN_ROWS * 4, hipMemcpyDeviceToHost));

  auto maxrel = [](const float* got, const float* ref, size_t n) {
    double m = 0; for (size_t i = 0; i < n; i++) {
      double d = std::fabs((double)got[i] - ref[i]);
      double r = d / std::max(std::fabs((double)ref[i]), 1e-3);
      if (r > m) m = r;
    } return m;
  };
  printf("\n-- correctness (max rel err per expert, denom max(|ref|,1e-3)) --\n");
  double gmax = 0, amax = 0;
  for (int e = 0; e < E; e++) {
    double ge = maxrel(gu_got.data() + (size_t)e * GU_ROWS, gu_ref.data() + (size_t)e * GU_ROWS, GU_ROWS);
    double ae = maxrel(act_got.data() + (size_t)e * INTER, act_ref.data() + (size_t)e * INTER, INTER);
    gmax = std::max(gmax, ge); amax = std::max(amax, ae);
    printf("expert %d: gate_up %.3e  act %.3e\n", e, ge, ae);
  }
  double oe = maxrel(out_got.data(), out_ref.data(), DN_ROWS);
  printf("out (all experts fused): %.3e   [gate_up max %.3e, act max %.3e]\n", oe, gmax, amax);
  printf("GATE rel-err<3e-2: %s\n", (gmax < 3e-2 && amax < 3e-2 && oe < 3e-2) ? "PASS" : "FAIL");

  // ---- performance: hipEvent, warm + best of 20 ----
  hipEvent_t ev0, ev1;
  CHK(hipEventCreate(&ev0)); CHK(hipEventCreate(&ev1));
  launch_layer(); CHK(hipDeviceSynchronize());          // warm
  float best_layer = 1e30f;
  for (int i = 0; i < 20; i++) {
    CHK(hipEventRecord(ev0)); launch_layer(); CHK(hipEventRecord(ev1));
    CHK(hipEventSynchronize(ev1));
    float ms; CHK(hipEventElapsedTime(&ms, ev0, ev1));
    best_layer = std::min(best_layer, ms);
  }
  printf("\n-- perf --\n");
  printf("layer weight bytes: %.2f MB (task quote was ~10.7MB; actual layout = %.2f MB)\n",
         LAYER_BYTES / 1e6, LAYER_BYTES / 1e6);
  printf("per-layer 8-expert fused call: best %.3f ms -> %.1f GB/s\n",
         best_layer, LAYER_BYTES / (best_layer / 1e3) / 1e9);

  const int LAYERS = 40;
  launch_layer(); CHK(hipDeviceSynchronize());          // warm chain
  float best_tok = 1e30f;
  for (int i = 0; i < 20; i++) {
    CHK(hipEventRecord(ev0));
    for (int l = 0; l < LAYERS; l++) launch_layer();    // sequential, like the real model
    CHK(hipEventRecord(ev1));
    CHK(hipEventSynchronize(ev1));
    float ms; CHK(hipEventElapsedTime(&ms, ev0, ev1));
    best_tok = std::min(best_tok, ms);
  }
  float floor_ms = (float)(LAYER_BYTES * LAYERS) / 37.4e9f * 1e3f;   // P0 median 37.4 GB/s
  printf("40-layer back-to-back: best %.3f ms/token -> %.1f GB/s effective\n",
         best_tok, (double)LAYER_BYTES * LAYERS / (best_tok / 1e3) / 1e9);
  printf("projected decode: %.1f t/s  (P0 floor 14.5 ms/token -> %.1f t/s; bandwidth floor at 37.4 GB/s = %.2f ms/token)\n",
         1000.0 / best_tok, 1000.0 / 14.5, floor_ms);
  printf("GATE 40-layer <= 18 ms/token: %s (%.2f ms)\n", best_tok <= 18.f ? "PASS" : "FAIL", best_tok);
  printf("DONE\n");
  return 0;
}
