#version 450
layout(local_size_x = 256) in;
layout(binding = 0) buffer c_blob { float c_blob_data[]; };  // 非 writeonly
void main() {
    const uint gx = gl_GlobalInvocationID.x;
    float c = float(gx) * 1.0001;
    c = c * 1.5 + 0.25;
    c = c * c - c;
    c_blob_data[gx] = c;
    memoryBarrierBuffer();
    barrier();
    float r = c_blob_data[gx];  // 读回
    c_blob_data[gx] = r * 1.0000001;
}
